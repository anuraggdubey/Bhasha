# ==============================================================================
# Bhasha — Environment Configuration
# ==============================================================================

# AssemblyAI API Key (Required for STT / Dictation API)
# Get your key at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# LLM API Key (OpenAI / Anthropic / Groq / Gemini for Meaning Packet extraction)
# Recommended: GPT-4o, Claude 3.5 Sonnet, or Gemini 1.5 Pro
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Preferred LLM Provider (openai | anthropic | mock)
LLM_PROVIDER=openai

# Mock Mode (Set to true to bypass external API calls during offline testing/demos)
NEXT_PUBLIC_USE_MOCK_DATA=false

# App Base URL (defaults to http://localhost:3000 in local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
